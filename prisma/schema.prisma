generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS
// ==========================================
// One table for both sides of the marketplace:
//   CLIENT    -> web dashboard user (email + password) who owns datasets
//   EVALUATOR -> Telegram Mini App user who labels tasks
//   ADMIN     -> operator

enum Role {
  EVALUATOR
  CLIENT
  ADMIN
}

// Legacy NextAuth tables. Unused by the app, kept so no data is dropped.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Telegram identity (evaluators)
  telegramId      String? @unique
  username        String?
  firstName       String?
  lastName        String?
  languageCode    String?
  photoUrl        String?
  isPremium       Boolean @default(false)
  // Whether the user allowed the bot to message them (from initData).
  allowsWriteToPm Boolean @default(false)

  // Display value of `trust`, 0..100.
  reputation      Int      @default(75)
  // Estimated probability that this evaluator answers correctly, from their recent
  // golden answers (see services/trust.ts). Weights their votes and gates their work.
  trust           Float    @default(0.75)
  goldAnswered    Int      @default(0)
  lastGoldCorrect Boolean?
  // Money is stored as integer cents to avoid float rounding.
  // Spendable or withdrawable money: the sum of the user's AVAILABLE ledger entries.
  balanceCents    Int      @default(0)
  // Evaluator rewards still in their hold period: the sum of PENDING ledger entries.
  pendingCents    Int      @default(0)

  role Role @default(EVALUATOR)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  votes         Vote[]
  assignments   TaskAssignment[]
  datasets      Dataset[]
  ledgerEntries LedgerEntry[]
  tonWallet     TonWallet?
  withdrawals   Withdrawal[]
}

// ==========================================
// DATASETS, TASKS, VOTES
// ==========================================

enum DatasetStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum DataType {
  TEXT
  IMAGE
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  // Evaluators still disagreed at the dataset's maxVotes. Needs human review.
  DISPUTED
}

model Dataset {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      DatasetStatus @default(PAUSED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  dataType      DataType
  question      String
  options       String[]
  // Paid to the evaluator per accepted vote, in cents.
  rewardCents   Int      @default(50)
  // Votes every item gets. Items whose votes disagree escalate, up to maxVotes.
  requiredVotes Int      @default(2)
  maxVotes      Int      @default(4)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks         Task[]
  ledgerEntries LedgerEntry[]

  @@index([ownerId])
  @@index([status, createdAt])
}

model Task {
  id        String  @id @default(cuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // TEXT datasets: the text to label. IMAGE datasets: the source value (usually the URL).
  content   String
  imageUrls String[]

  collectedVotes Int        @default(0)
  // Votes this item needs right now. Starts at the dataset's requiredVotes and grows
  // when the votes disagree. Unused for golden tasks.
  targetVotes    Int        @default(2)
  status         TaskStatus @default(ACTIVE)

  // Golden (validation) tasks have a known answer and are used to score evaluators.
  // They are never completed and are never shown to evaluators as special. Their
  // collectedVotes counts exposures; they are retired after GOLD_MAX_EXPOSURES.
  isValidation  Boolean @default(false)
  correctAnswer String?

  // Filled when the task is resolved.
  consensusLabel String?
  // Share of votes that agreed with consensusLabel, 0..1.
  agreement      Float?
  // Trust-weighted probability that consensusLabel is right, 0..1.
  confidence     Float?
  completedAt    DateTime?

  createdAt   DateTime         @default(now())
  votes       Vote[]
  assignments TaskAssignment[]

  @@index([datasetId, status, collectedVotes])
}

// A task served to an evaluator and not answered yet. Holds one of the task's vote
// slots until it expires, so a task is never handed out to more evaluators than it needs.
model TaskAssignment {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Vote {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  selection   String
  // Only set for golden tasks.
  isCorrect   Boolean?
  // What the evaluator was paid for this vote, in cents.
  rewardCents Int      @default(0)
  // Time since the task was served or the evaluator's previous answer, whichever is
  // later. Used to spot answers too fast to be real.
  responseMs  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Votes are immutable and one per evaluator per task.
  @@unique([userId, taskId])
  @@index([taskId])
  @@index([userId, createdAt])
}

// ==========================================
// LEDGER
// ==========================================
// Append-only record of every balance change. Each entry lands in one bucket, and a
// user's balanceCents / pendingCents always equal the sums of their AVAILABLE / PENDING
// entries. Writes go through server/ledger.

enum LedgerType {
  TOP_UP
  TASK_CHARGE // debit from the dataset owner: the evaluator's reward
  PLATFORM_FEE // debit from the dataset owner: the platform's fee on top of the reward
  TASK_REWARD // credit to the evaluator, PENDING until availableAt
  REWARD_RELEASE // moves matured rewards from PENDING to AVAILABLE (one entry per bucket)
  CLAWBACK // removes a suspended evaluator's unreleased rewards
  REWARD_REFUND // returns clawed-back rewards to the dataset owner
  WITHDRAWAL // debit for a payout request
  WITHDRAWAL_REVERSAL // credit back when a payout is rejected or fails
  ADJUSTMENT
}

enum LedgerBucket {
  AVAILABLE
  PENDING
}

model LedgerEntry {
  id           String       @id @default(cuid())
  userId       String
  type         LedgerType
  bucket       LedgerBucket @default(AVAILABLE)
  // Signed: positive credits the user, negative debits them.
  amountCents  Int
  datasetId    String?
  voteId       String?
  withdrawalId String?
  note         String?
  // TASK_REWARD only: when the reward may be released, and when it was released or clawed back.
  availableAt  DateTime?
  settledAt    DateTime?
  createdAt    DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, bucket, settledAt])
  @@index([datasetId])
}

// ==========================================
// PAYOUTS
// ==========================================

// The TON wallet an evaluator is paid to, proven theirs with TON Connect's ton_proof.
// An address can belong to one account only, which also stops one person from
// cashing out several accounts to the same wallet.
model TonWallet {
  userId    String   @id
  // Raw form, "<workchain>:<hex>".
  address   String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WithdrawalStatus {
  REQUESTED // funds held, waiting for review
  APPROVED // reviewed, waiting for the payout script
  SENDING // handed to the network; never resent automatically
  SENT // the hot wallet's transaction is on chain
  REJECTED // refused in review; funds returned
  FAILED // sending failed; funds returned
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  amountCents Int
  // Raw destination address, copied from the linked wallet at request time.
  address     String
  asset       String           @default("USDT")
  status      WithdrawalStatus @default(REQUESTED)
  // Ties the on-chain jetton transfer back to this row.
  queryId     BigInt           @unique @default(autoincrement())
  txHash      String?
  note        String?
  createdAt   DateTime         @default(now())
  reviewedAt  DateTime?
  sentAt      DateTime?
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
