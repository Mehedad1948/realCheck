generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS
// ==========================================
// One table for both sides of the marketplace:
//   CLIENT    -> web dashboard user (email + password) who owns datasets
//   EVALUATOR -> Telegram Mini App user who labels tasks
//   ADMIN     -> operator

enum Role {
  EVALUATOR
  CLIENT
  ADMIN
}

// Legacy NextAuth tables. Unused by the app, kept so no data is dropped.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Telegram identity (evaluators)
  telegramId      String? @unique
  username        String?
  firstName       String?
  lastName        String?
  languageCode    String?
  photoUrl        String?
  isPremium       Boolean @default(false)
  // Whether the user allowed the bot to message them (from initData).
  allowsWriteToPm Boolean @default(false)

  // Display value of `trust`, 0..100.
  reputation      Int      @default(75)
  // Estimated probability that this evaluator answers correctly, from their recent
  // golden answers (see services/trust.ts). Weights their votes and gates their work.
  trust           Float    @default(0.75)
  goldAnswered    Int      @default(0)
  lastGoldCorrect Boolean?
  // Money is stored as integer cents to avoid float rounding.
  balanceCents    Int      @default(0)

  role Role @default(EVALUATOR)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  votes         Vote[]
  assignments   TaskAssignment[]
  datasets      Dataset[]
  ledgerEntries LedgerEntry[]
}

// ==========================================
// DATASETS, TASKS, VOTES
// ==========================================

enum DatasetStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum DataType {
  TEXT
  IMAGE
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  // Evaluators still disagreed at the dataset's maxVotes. Needs human review.
  DISPUTED
}

model Dataset {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      DatasetStatus @default(PAUSED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  dataType      DataType
  question      String
  options       String[]
  // Paid to the evaluator per accepted vote, in cents.
  rewardCents   Int      @default(50)
  // Votes every item gets. Items whose votes disagree escalate, up to maxVotes.
  requiredVotes Int      @default(2)
  maxVotes      Int      @default(4)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks         Task[]
  ledgerEntries LedgerEntry[]

  @@index([ownerId])
  @@index([status, createdAt])
}

model Task {
  id        String  @id @default(cuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // TEXT datasets: the text to label. IMAGE datasets: the source value (usually the URL).
  content   String
  imageUrls String[]

  collectedVotes Int        @default(0)
  // Votes this item needs right now. Starts at the dataset's requiredVotes and grows
  // when the votes disagree. Unused for golden tasks.
  targetVotes    Int        @default(2)
  status         TaskStatus @default(ACTIVE)

  // Golden (validation) tasks have a known answer and are used to score evaluators.
  // They are never completed and are never shown to evaluators as special. Their
  // collectedVotes counts exposures; they are retired after GOLD_MAX_EXPOSURES.
  isValidation  Boolean @default(false)
  correctAnswer String?

  // Filled when the task is resolved.
  consensusLabel String?
  // Share of votes that agreed with consensusLabel, 0..1.
  agreement      Float?
  // Trust-weighted probability that consensusLabel is right, 0..1.
  confidence     Float?
  completedAt    DateTime?

  createdAt   DateTime         @default(now())
  votes       Vote[]
  assignments TaskAssignment[]

  @@index([datasetId, status, collectedVotes])
}

// A task served to an evaluator and not answered yet. Holds one of the task's vote
// slots until it expires, so a task is never handed out to more evaluators than it needs.
model TaskAssignment {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Vote {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  selection   String
  // Only set for golden tasks.
  isCorrect   Boolean?
  // What the evaluator was paid for this vote, in cents.
  rewardCents Int      @default(0)
  // Time since the task was served or the evaluator's previous answer, whichever is
  // later. Used to spot answers too fast to be real.
  responseMs  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Votes are immutable and one per evaluator per task.
  @@unique([userId, taskId])
  @@index([taskId])
  @@index([userId, createdAt])
}

// ==========================================
// LEDGER
// ==========================================
// Append-only record of every balance change. A user's balanceCents should
// always equal the sum of their ledger amounts.

enum LedgerType {
  TOP_UP
  TASK_CHARGE // debit from the dataset owner
  TASK_REWARD // credit to the evaluator
  ADJUSTMENT
}

model LedgerEntry {
  id          String     @id @default(cuid())
  userId      String
  type        LedgerType
  // Signed: positive credits the user, negative debits them.
  amountCents Int
  datasetId   String?
  voteId      String?
  note        String?
  createdAt   DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([datasetId])
}
